AddDefaultCharset UTF-8

# Aeltere Apache-Versionen kennen .webp nicht und liefern die Datei sonst mit
# dem MIME-Typ des Originals aus.
AddType image/webp .webp

# Video support
AddType video/ogg .ogv
AddType video/mp4 .mp4
AddType video/webm .webm
AddType video/ogv .ogv

# Audio support
AddType audio/mp3 .mp3
AddType audio/oga .oga
AddType audio/ogg .ogg
AddType audio/wav .wav

# For HLS support
AddType application/x-mpegURL .m3u8
AddType vnd.apple.mpegURL .m3u8
AddType video/MP2T .ts

# For M(PEG)-DASH support
AddType application/dash+xml .mpd

# For subtitles support
AddType text/vtt .vtt
AddType text/srt .srt

# Deflate Compression by FileType
<IfModule mod_deflate.c>
 AddOutputFilterByType DEFLATE text/plain
 AddOutputFilterByType DEFLATE text/html
 AddOutputFilterByType DEFLATE text/xml
 AddOutputFilterByType DEFLATE text/css
 AddOutputFilterByType DEFLATE text/javascript
 AddOutputFilterByType DEFLATE application/xml
 AddOutputFilterByType DEFLATE application/xhtml+xml
 AddOutputFilterByType DEFLATE application/rss+xml
 AddOutputFilterByType DEFLATE application/atom_xml
 AddOutputFilterByType DEFLATE application/javascript
 AddOutputFilterByType DEFLATE application/x-javascript
 AddOutputFilterByType DEFLATE application/x-shockwave-flash
</IfModule>

# Browser-Caching
#
# Lighthouse "Use efficient cache lifetimes" bemaengelte drei Faelle: Schriften
# und SVG-Symbole gingen voellig ohne Angabe raus, das Stylesheet mit sieben
# Tagen. Der Wert richtet sich danach, ob die Adresse sich aendert, wenn sich
# die Datei aendert:
#
#   CSS/JS      werden mit ?time=<filemtime> eingebunden (siehe
#               frontend_functions.inc.php) - nach jedem Build eine neue
#               Adresse, ein alter Stand kann gar nicht haengen bleiben.
#   Schriften   tragen ?v=<version> aus dem Stylesheet, gleiche Lage.
#   Bilder/SVG  behalten ihre Adresse. Hier bleibt es bei 30 Tagen: ein
#               ausgetauschtes Bild soll nicht ein Jahr lang alt bleiben.
#   HTML        kommt aus dem CMS und wird nie zwischengespeichert. PHP setzt
#               dafuer bereits no-store, die Regel unten war wirkungslos -
#               und waere, wenn sie gegriffen haette, ein Fehler gewesen:
#               eine Textaenderung waere einen Monat lang nicht sichtbar.
#
# Wichtig zur Reihenfolge: mod_headers gewinnt gegen mod_expires. Was unten in
# FilesMatch steht, ueberschreibt also jede ExpiresByType-Angabe - deshalb sind
# die beiden Bloecke aufeinander abgestimmt und nicht mehr gegenlaeufig.
<IfModule mod_expires.c>
 ExpiresActive On
 ExpiresByType text/css "access plus 1 year"
 ExpiresByType text/javascript "access plus 1 year"
 ExpiresByType application/javascript "access plus 1 year"
 ExpiresByType font/woff2 "access plus 1 year"
 ExpiresByType font/woff "access plus 1 year"
 ExpiresByType font/ttf "access plus 1 year"
 ExpiresByType font/otf "access plus 1 year"
 ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
 ExpiresByType image/svg+xml "access plus 1 month"
 ExpiresByType image/webp "access plus 1 month"
 ExpiresByType image/avif "access plus 1 month"
 ExpiresByType image/gif "access plus 1 month"
 ExpiresByType image/jpeg "access plus 1 month"
 ExpiresByType image/png "access plus 1 month"
 ExpiresByType image/x-icon "access plus 1 month"
</IfModule>

# Aeltere Apache-Versionen kennen die Schrift-MIME-Typen nicht und liefern die
# Dateien sonst als application/octet-stream aus - ExpiresByType greift dann
# nicht. Die FilesMatch-Regeln unten haengen nicht am MIME-Typ und wirken
# trotzdem, aber richtig ausgezeichnet ist besser.
<IfModule mod_mime.c>
 AddType font/woff2 .woff2
 AddType font/woff .woff
 AddType font/ttf .ttf
 AddType font/otf .otf
 AddType application/vnd.ms-fontobject .eot
 AddType image/svg+xml .svg
</IfModule>

<IfModule mod_headers.c>
 # Versionierte Adresse - ein Jahr, unveraenderlich. "immutable" erspart dem
 # Browser die Rueckfrage beim Neuladen der Seite.
 <FilesMatch "\.(css|js|woff2?|ttf|otf|eot)$">
  Header set Cache-Control "max-age=31536000, public, immutable"
 </FilesMatch>

 # Gleichbleibende Adresse - 30 Tage.
 <FilesMatch "\.(ico|jpe?g|png|gif|webp|avif|svg|swf)$">
  Header set Cache-Control "max-age=2592000, public"
 </FilesMatch>
</IfModule>

# Komprimierung fuer die Dateitypen, die nicht schon ueber AddOutputFilterByType
# oben abgedeckt sind. woff2 und die Bildformate sind bereits komprimiert und
# gehoeren bewusst nicht dazu - ein zweiter Durchgang kostet Rechenzeit und
# bringt nichts.
<IfModule mod_deflate.c>
 AddOutputFilterByType DEFLATE image/svg+xml
 AddOutputFilterByType DEFLATE application/json
 AddOutputFilterByType DEFLATE font/ttf
 AddOutputFilterByType DEFLATE font/otf
</IfModule>

<ifmodule mod_headers.c>
    SetEnvIf Host ^dc-test\.de$ is_on_dev_site
    Header set X-Robots-Tag "noindex, nofollow" env=is_on_dev_site

    # Ohne diesen Header koennte ein Proxy die WebP-Antwort an einen Browser
    # weiterreichen, der damit nichts anfangen kann.
    Header append Vary Accept env=WEBP_VARIANTE
</ifmodule>

RewriteEngine on

RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# WebP ausliefern, wo es eine Variante gibt
#
# Die Bilder liegen als CKEditor-HTML in der Datenbank - die <img>-Tags
# koennen wir also nicht einfach umschreiben. Stattdessen entscheidet der
# Server: Akzeptiert der Browser image/webp und liegt neben bild.jpg auch
# bild.jpg.webp, geht die kleinere Datei raus. Gleiche URL, gleiche
# Abmessungen, nur ein anderes Format.
#
# Die Varianten erzeugt tools/webp-convert.php.
# Zum Abschalten reicht es, diesen Block auszukommentieren.
RewriteCond %{HTTP_ACCEPT} image/webp
RewriteCond %{REQUEST_FILENAME} \.(jpe?g|png)$ [NC]
RewriteCond %{REQUEST_FILENAME}\.webp -f
RewriteRule ^(.+)\.(jpe?g|png)$ $1.$2.webp [NC,T=image/webp,E=WEBP_VARIANTE:1,L]

#FallbackResource /dc/frontend/frontend.php


RewriteRule ^layout/frontend/css/([^/.]*)/([^/.]*)/$ /dc/frontend/css.php?layout_id=$1&page_id=$2 [L,QSA]

#RewriteCond %{REQUEST_FILENAME} !-f
#RewriteRule ^dc/(.*)$ /dc/admin/admin.php [L,QSA]
#RewriteRule ^dc/$ /dc/admin/admin.php?site=$1 [L,QSA]
#RewriteRule ^dc/([^/.]*)/$ /dc/admin/admin.php?site=$1&language=$2 [L,QSA]
#RewriteRule ^dc/([^/.]*)/([^/.]*)/$ /dc/admin/admin.php?site=$1&language=$2&level_1=$3 [L,QSA]
#RewriteRule ^dc/([^/.]*)/([^/.]*)/([^/.]*)/$ /dc/admin/admin.php?site=$1&language=$2&level_1=$3&level_2=$4 [L,QSA]
#RewriteRule ^dc/([^/.]*)/([^/.]*)/([^/.]*)/([^/.]*)/$ /dc/admin/admin.php?site=$1&language=$2&level_1=$3&level_2=$4&level_3=$5 [L,QSA]

#RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(layout|userdata)($|/) - [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ /dc/frontend/frontend.php [L,QSA]

#RewriteRule ^([^/.]*)/([^/.]*)/shop/([^/.]*)/$ /dc/frontend/frontend.php?site=$1&language=$2&level_1=shop&slevel_1=$3 [L,QSA]
#RewriteRule ^([^/.]*)/([^/.]*)/shop/([^/.]*)/([^/.]*)/$ /dc/frontend/frontend.php?site=$1&language=$2&level_1=shop&slevel_1=$3&slevel_2=$4 [L,QSA]
#RewriteRule ^([^/.]*)/([^/.]*)/shop/([^/.]*)/([^/.]*)/([^/.]*)/$ /dc/frontend/frontend.php?site=$1&language=$2&level_1=shop&slevel_1=$3&slevel_2=$4&slevel_3=$5 [L,QSA]
#RewriteRule ^([^/.]*)/([^/.]*)/shop/([^/.]*)/([^/.]*)/([^/.]*)/([^/.]*)/$ /dc/frontend/frontend.php?site=$1&language=$2&level_1=shop&slevel_1=$3&slevel_2=$4&slevel_3=$5&slevel_4=$6 [L,QSA]
#RewriteRule ^([^/.]*)/([^/.]*)/shop/([^/.]*)/([^/.]*)/([^/.]*)/([^/.]*)/([^/.]*)/$ /dc/frontend/frontend.php?site=$1&language=$2&level_1=shop&slevel_1=$3&slevel_2=$4&slevel_3=$5&slevel_4=$6&slevel_5=$7 [L,QSA]
#RewriteRule ^([^/.]*)/([^/.]*)/shop/([^/.]*)/([^/.]*)/([^/.]*)/([^/.]*)/([^/.]*)/([^/.]*)/$ /dc/frontend/frontend.php?site=$1&language=$2&level_1=shop&slevel_1=$3&slevel_2=$4&slevel_3=$5&slevel_4=$6&slevel_5=$7&slevel_6=$8 [L,QSA]

#RewriteRule ^(.*)$ /dc/frontend/frontend.php [L,QSA]
#RewriteRule ^([^/.]*)/$ /dc/frontend/frontend.php?site=$1 [L,QSA]
#RewriteRule ^([^/.]*)/([^/.]*)/$ /dc/frontend/frontend.php?site=$1&language=$2 [L,QSA]
#RewriteRule ^([^/.]*)/([^/.]*)/([^/.]*)/$ /dc/frontend/frontend.php?site=$1&language=$2&level_1=$3 [L,QSA]
#RewriteRule ^([^/.]*)/([^/.]*)/([^/.]*)/([^/.]*)/$ /dc/frontend/frontend.php?site=$1&language=$2&level_1=$3&level_2=$4 [L,QSA]
#RewriteRule ^([^/.]*)/([^/.]*)/([^/.]*)/([^/.]*)/([^/.]*)/$ /dc/frontend/frontend.php?site=$1&language=$2&level_1=$3&level_2=$4&level_3=$5 [L,QSA]
#RewriteRule ^([^/.]*)/([^/.]*)/([^/.]*)/([^/.]*)/([^/.]*)/([^/.]*)/$ /dc/frontend/frontend.php?site=$1&language=$2&level_1=$3&level_2=$4&level_3=$5&level_4=$6 [L,QSA]
#RewriteRule ^([^/.]*)/([^/.]*)/([^/.]*)/([^/.]*)/([^/.]*)/([^/.]*)/([^/.]*)/$ /dc/frontend/frontend.php?site=$1&language=$2&level_1=$3&level_2=$4&level_3=$5&level_4=$6&level_5=$7 [L,QSA]
#RewriteRule ^([^/.]*)/([^/.]*)/([^/.]*)/([^/.]*)/([^/.]*)/([^/.]*)/([^/.]*)/([^/.]*)/$ /dc/frontend/frontend.php?site=$1&language=$2&level_1=$3&level_2=$4&level_3=$5&level_4=$6&level_5=$7&level_6=$8 [L,QSA]

