+<?php
+$translation = \Registry::get("translation");
+
+$query             = "SELECT * FROM main_admin_user_shop_link where main_admin_user_id = '" . (int)$GLOBALS["admin_user"]['id']."'";
+$result            = @mysqli_query($GLOBALS['mysql_con'], $query);
+$siteAdminAvailableShops = array();
+if (@mysqli_num_rows($result) > 0) {
+    $shopAdminLink = true;
+    while ($row = @mysqli_fetch_array($result)) {
+        if($row['active'] == 1) {
+            $siteAdminAvailableShops[] = $row['shop_code'];
+        }
+    }
+} else {
+    $shopAdminLink = false;
+}
+
+$zeitraum_values = array(
+    "%d.%m.%Y",
+    "KW%v-%x",
+    "%m/%Y",
+    "%Y"
+);
+
+$zeitraum_names = array(
+    $translation->get("days"),
+    $translation->get("calendarweeks"),
+    $translation->get("months"),
+    $translation->get("years")
+);
+
+$von_value = "";
+$bis_value = date("d.m.Y", time());
+
+if (isset($_POST['input_from'])) {
+    $von_value = $_POST['input_from'];
+    $bis_value = $_POST['input_to'];
+}
+
+if ($_POST['input_shop'] != $_POST['old_shop_code']) {
+    $von_value = "";
+}
+?>
+
+<div id="mainContent">
+    <?php echo current_website_language($site, $language); ?>
+    <h1><?php echo get_translation('cookie_stat'); ?></h1>
+
+    <div class="clearfix"></div>
+    <form id="cookie_statistic_form" name="cookie_statistic_form" action="<?php $PHP_SELF; ?>" method=POST>
+        <input type="hidden" value="<?php echo $_POST['input_shop']; ?>" name="old_shop_code"/>
+        <div class="requestLoader"></div>
+        <table class="cardform" style="width:960px;" border="0" cellspacing="0" cellpadding="0">
+            <tr>
+                <td>
+                    <?php input($translation->get("from"), "input_from", "date", $von_value, 10); ?>
+                    <?php input($translation->get("to"), "input_to", "date", $bis_value, 10); ?>
+                </td>
+            </tr>
+        </table>
+        <input type="submit" value="Aktualisieren" style="display:none;"/>
+    </form>
+    <script type="text/javascript">
+        $(document).ready(function () {
+            $('#mainContent input.date').datepicker("option", "onSelect", function () {
+                $('#cookie_statistic_form').submit();
+            });
+        })
+
+    </script>
+    <?php
+    if ($_POST['input_interval'] == "") {
+        $interval = "%d.%m.%Y";
+    } else {
+        $interval = $_POST['input_interval'];
+    }
+
+    $query = "SET @row_number:=0;";
+    @mysqli_query($GLOBALS['mysql_con'], $query);
+
+    // where zeitraum
+    $von_value = "'" . str_replace("'","", datetosql($von_value)) . " 00:00:00'";
+    $bis_value = "'" . str_replace("'","", datetosql($bis_value)) . " 23:59:59'";
+
+    $query="
+SELECT
+    -- CONCAT(@start , '  bis  ' , @end) AS 'Zeitraum',
+    'GESAMT' AS 'site_code',
+    t1.total_distinct_count AS 'Auspielungen',
+    t5.total_display_with_interaction AS 'Interaktion',
+    t2.total_accept_all AS 'Alle akz.',
+    t3.total_decline_all AS 'Alle verw.',
+    t6.total_more_information AS 'Mehr Infos',
+    t4.ga_accepted_other AS 'GA nachtr.',
+    CONCAT(t5.total_display_with_interaction / t1.total_distinct_count * 100 ,' %') AS 'Banner-Intera.',
+    t2.total_accept_all + t4.ga_accepted_other AS 'GA akz. gesamt',
+    CONCAT((t2.total_accept_all + t4.ga_accepted_other) / t5.total_display_with_interaction * 100, ' %') AS 'GA akz.- Intera.',
+    CONCAT((t2.total_accept_all + t4.ga_accepted_other) / t1.total_distinct_count * 100, ' %') AS 'GA akz.- gesamt'
+FROM
+    (
+        SELECT
+            COUNT(DISTINCT(sid)) as total_distinct_count
+        FROM
+            dc_cookie
+        WHERE
+            action = 'ACTION_SHOW_BANNER'
+            AND datetime >= ".$von_value."
+            AND datetime <= ".$bis_value."
+    ) as t1
+    JOIN
+    (
+        SELECT
+            COUNT(DISTINCT(sid)) AS total_accept_all
+        FROM
+            dc_cookie
+        WHERE
+            action = 'ACTION_ACCEPT_ALL'
+            AND datetime >= ".$von_value."
+            AND datetime <= ".$bis_value."
+    ) as t2
+    JOIN
+    (
+        SELECT
+            COUNT(DISTINCT(sid)) AS total_decline_all
+        FROM
+            dc_cookie
+        WHERE
+            action = 'ACTION_DECLINE_ALL'
+            AND datetime >= ".$von_value."
+            AND datetime <= ".$bis_value."
+    ) as t3
+    JOIN
+    (
+        SELECT
+            COUNT(DISTINCT(sid)) AS ga_accepted_other
+        FROM
+            dc_cookie
+        WHERE
+            action = 'ACTION_SAVE_CUSTOM'
+            AND state LIKE '%{\"id\":\"google_analytics\",\"state\":true}%'
+            AND datetime >= ".$von_value."
+            AND datetime <= ".$bis_value."
+    ) as t4
+    JOIN
+    (
+        SELECT
+            COUNT(DISTINCT (ts1.sid)) AS total_display_with_interaction
+        FROM
+            dc_cookie ts1
+            INNER JOIN dc_cookie ts2 ON (
+                ts1.sid = ts2.sid
+                AND (
+                    ts2.action = 'ACTION_ACCEPT_ALL'
+                    OR ts2.action = 'ACTION_DECLINE_ALL'
+                    OR ts2.action = 'ACTION_MORE_INFORMATION'
+                )
+            )
+        WHERE
+            ts1.action = 'ACTION_SHOW_BANNER'
+            AND ts1.datetime >= ".$von_value."
+            AND ts1.datetime <= ".$bis_value."
+    ) as t5
+    JOIN
+    (
+        SELECT
+            COUNT(DISTINCT(sid)) AS total_more_information
+        FROM
+            dc_cookie
+        WHERE
+            action = 'ACTION_MORE_INFORMATION'
+            AND datetime >= ".$von_value."
+            AND datetime <= ".$bis_value."
+    ) as t6
+    UNION
+	SELECT
+    -- CONCAT(@start , '  bis  ' , @end) AS 'Zeitraum',
+    t1.site_code,
+    COALESCE(t1.total_distinct_count, 0) AS 'Auspielungen',
+    COALESCE(t5.total_display_with_interaction, 0) AS 'Interaktion',
+    COALESCE(t2.total_accept_all, 0) AS 'Alle akz.',
+    COALESCE(t3.total_decline_all, 0) AS 'Alle verw.',
+    COALESCE(t6.total_more_information, 0) AS 'Mehr Infos',
+    COALESCE(t4.ga_accepted_other, 0) AS 'GA nachtr.',
+    CONCAT(COALESCE(t5.total_display_with_interaction, 0) / COALESCE(t1.total_distinct_count, 1) * 100 ,' %') AS 'Banner-Intera.',
+    COALESCE(t2.total_accept_all, 0) + COALESCE(t4.ga_accepted_other, 0) AS 'GA akz. gesamt',
+    CONCAT((COALESCE(t2.total_accept_all, 0) + COALESCE(t4.ga_accepted_other, 0)) / COALESCE(t5.total_display_with_interaction, 1) * 100, ' %') AS 'GA akz.- Intera.',
+    CONCAT((COALESCE(t2.total_accept_all, 0) + COALESCE(t4.ga_accepted_other, 0)) / COALESCE(t1.total_distinct_count, 1) * 100, ' %') AS 'GA akz.- gesamt'
+FROM
+    (
+        SELECT
+            COUNT(DISTINCT(sid)) as total_distinct_count,
+            site_code
+        FROM
+            dc_cookie
+        WHERE
+            action = 'ACTION_SHOW_BANNER'
+            AND datetime >= ".$von_value."
+            AND datetime <= ".$bis_value."
+        GROUP BY site_code
+    ) as t1
+    LEFT JOIN
+    (
+        SELECT
+            COUNT(DISTINCT(sid)) AS total_accept_all,
+            site_code
+        FROM
+            dc_cookie
+        WHERE
+            action = 'ACTION_ACCEPT_ALL'
+            AND datetime >= ".$von_value."
+            AND datetime <= ".$bis_value."
+        GROUP BY site_code
+    ) as t2 ON (t1.site_code = t2.site_code)
+    LEFT JOIN
+    (
+        SELECT
+            COUNT(DISTINCT(sid)) AS total_decline_all,
+            site_code
+        FROM
+            dc_cookie
+        WHERE
+            action = 'ACTION_DECLINE_ALL'
+            AND datetime >= ".$von_value."
+            AND datetime <= ".$bis_value."
+        GROUP BY site_code
+    ) as t3 ON (t1.site_code = t3.site_code)
+    LEFT JOIN
+    (
+        SELECT
+            COUNT(DISTINCT(sid)) AS ga_accepted_other,
+            site_code
+        FROM
+            dc_cookie
+        WHERE
+            action = 'ACTION_SAVE_CUSTOM'
+            AND state LIKE '%{\"id\":\"google_analytics\",\"state\":true}%'
+            AND datetime >= ".$von_value."
+            AND datetime <= ".$bis_value."
+        GROUP BY site_code
+    ) as t4 ON (t1.site_code = t4.site_code)
+    LEFT JOIN
+    (
+        SELECT
+            COUNT(DISTINCT (ts1.sid)) AS total_display_with_interaction,
+            ts1.site_code
+        FROM
+            dc_cookie ts1
+            INNER JOIN dc_cookie ts2 ON (
+                ts1.sid = ts2.sid
+                AND (
+                    ts2.action = 'ACTION_ACCEPT_ALL'
+                    OR ts2.action = 'ACTION_DECLINE_ALL'
+                    OR ts2.action = 'ACTION_MORE_INFORMATION'
+                )
+            )
+        WHERE
+            ts1.action = 'ACTION_SHOW_BANNER'
+            AND ts1.datetime >= ".$von_value."
+            AND ts1.datetime <= ".$bis_value."
+        GROUP BY site_code
+    ) as t5 ON (t1.site_code = t5.site_code)
+    LEFT JOIN
+    (
+        SELECT
+            COUNT(DISTINCT(sid)) AS total_more_information,
+            site_code
+        FROM
+            dc_cookie
+        WHERE
+            action = 'ACTION_MORE_INFORMATION'
+            AND datetime >= ".$von_value."
+            AND datetime <= ".$bis_value."
+        GROUP BY site_code
+    ) as t6 ON (t1.site_code = t6.site_code)
+    GROUP BY site_code
+";
+    if ($von_value <> '') {
+        $format = array('text', 'text', 'text', 'text', 'text', 'text', 'text', 'text', 'text', 'text');
+        if ($result = @mysqli_query($GLOBALS['mysql_con'], $query)) {
+            linklist($result, "", $format);
+        }
+    }
+    ?>
+
+</div>
