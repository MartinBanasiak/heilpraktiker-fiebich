                {{#fieldInputOptions.post_code.minlength}}
                   minlength="{{fieldInputOptions.post_code.minlength}}" {{/fieldInputOptions.post_code.minlength}}
                {{#fieldInputOptions.post_code.maxlength}}
                   maxlength="{{fieldInputOptions.post_code.minlength}}" {{/fieldInputOptions.post_code.maxlength}}
                {{#fieldInputOptions.post_code.pattern}}pattern="{{fieldInputOptions.post_code.pattern}}"{{/fieldInputOptions.post_code.pattern}}
                   class="form_input short_text_input shop_form_input customer_address_form_input"
                   id="customer_address_form_post_code_input" name="post_code" value="{{post_code}}"/>
        </div>
        <div class="form_label shop_form_label customer_address_form_label" id="customer_address_form_label_city">
