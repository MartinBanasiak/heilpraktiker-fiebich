<div class="form_wrapper shop_form_wrapper customer_address_form_wrapper">
    <form method="POST" action="/b2c/de/account/{{action}}/?action=shop_login_account&test_cont=1">
        <input type="hidden" name="id" value="{{id}}"/>
        <input type="hidden" name="company" value="{{company}}"/>
        <input type="hidden" name="customer_no" value="{{customer_no}}"/>
        <div class="form_label shop_form_label customer_address_form_label" id="customer_address_form_code_label">
            <label for="customer_address_form_code_input">{{codeLabel}}</label>
        </div>
        <div class="form_input_wrapper shop_form_input_wrapper customer_address_form_input_wrapper"
             id="customer_address_form_code_input_wraper">
            <input type="{{fieldInputOptions.code.type}}"
                {{#fieldInputOptions.code.required}} required {{/fieldInputOptions.code.required}}
                {{#fieldInputOptions.code.minlength}}
                   minlength="{{fieldInputOptions.code.minlength}}" {{/fieldInputOptions.code.minlength}}
                {{#fieldInputOptions.code.maxlength}}
                   maxlength="{{fieldInputOptions.code.minlength}}" {{/fieldInputOptions.code.maxlength}}
                {{#fieldInputOptions.code.pattern}}
                   pattern="{{fieldInputOptions.code.pattern}}" {{/fieldInputOptions.code.pattern}}
                   class="form_input short_text_input shop_form_input customer_address_form_input"
                   id="customer_address_form_code_input" name="code" value="{{code}}"/>
        </div>
        <div class="form_label shop_form_label customer_address_form_label" id="customer_address_form_label_name">
            <label for="customer_address_form_name_input">{{nameLabel}}</label>
        </div>
        <div class="form_input_wrapper shop_form_input_wrapper customer_address_form_input_wrapper"
             id="customer_address_form_name_input_wraper">
