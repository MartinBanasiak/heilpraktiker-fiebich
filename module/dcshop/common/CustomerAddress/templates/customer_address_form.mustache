                {{#fieldInputOptions.city.maxlength}}
                   maxlength="{{fieldInputOptions.city.maxlength}}" {{/fieldInputOptions.city.maxlength}}
                {{#fieldInputOptions.city.pattern}}pattern="{{fieldInputOptions.city.pattern}}"{{/fieldInputOptions.city.pattern}}
