                {{#fieldInputOptions.name_2.pattern}}pattern="{{fieldInputOptions.name_2.pattern}}"{{/fieldInputOptions.name_2.pattern}}
                   class="form_input short_text_input shop_form_input customer_address_form_input"
                   id="customer_address_form_name_2_input" name="name_2" value="{{name_2}}"/>
        </div>
        <div class="form_label shop_form_label customer_address_form_label" id="customer_address_form_label_name">
            <label for="customer_address_form_address_input">{{addressLabel}}</label>
        </div>
        <div class="form_input_wrapper shop_form_input_wrapper customer_address_form_input_wrapper"
             id="customer_address_form_address_input_wraper">
            <input type="{{fieldInputOptions.address.type}}"
                   {{#fieldInputOptions.address.required}}required{{/fieldInputOptions.address.required}}
