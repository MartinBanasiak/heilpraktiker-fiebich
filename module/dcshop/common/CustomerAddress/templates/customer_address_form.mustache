                {{#fieldInputOptions.name.maxlength}}
                   maxlength="{{fieldInputOptions.name.minlength}}" {{/fieldInputOptions.name.maxlength}}
                {{#fieldInputOptions.name.pattern}}pattern="{{fieldInputOptions.name.pattern}}"{{/fieldInputOptions.name.pattern}}
                   class="form_input short_text_input shop_form_input customer_address_form_input"
                   id="customer_address_form_name_input" name="name" value="{{name}}"/>
        </div>
        <div class="form_label shop_form_label customer_address_form_label" id="customer_address_form_label_name_2">
            <label for="customer_address_form_name_2_input">{{name2Label}}</label>
        </div>
