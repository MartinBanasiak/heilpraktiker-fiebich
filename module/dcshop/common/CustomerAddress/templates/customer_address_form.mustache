            <label for="customer_address_form_address_2_input">{{address2Label}}</label>
        </div>
        <div class="form_input_wrapper shop_form_input_wrapper customer_address_form_input_wrapper"
             id="customer_address_form_address_2_input_wraper">
            <input type="{{fieldInputOptions.address_2.type}}"
                   {{#fieldInputOptions.address_2.required}}required{{/fieldInputOptions.address_2.required}}
                {{#fieldInputOptions.address_2.minlength}}
