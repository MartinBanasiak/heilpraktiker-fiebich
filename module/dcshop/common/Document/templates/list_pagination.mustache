{{#listHasPagination}}
    <form method="POST" action="{{formURLValue}}" name="pagination_form">
        <input type="hidden" name="document_last_search_input" value="{{documentNoSearchValue}}"/>
        <input type="hidden" name="document_last_search_date_range" value="{{dateRangeSearchValue}}"/>
        <input type="hidden" name="document_last_document_type_filter" value="{{document_type_filter}}"/>
        <div class="page_switch">
            {{#listHasPaginationBackButton}}
                <button type="submit" class="page_switch_control page_switch_prev" name="page_value"
                        value="{{previousPageValue}}"
                        title="{{backButtonLable}}">
                    <i class="fa fa-angle-left" aria-hidden="true"></i></button>
            {{/listHasPaginationBackButton}}

            <span class="page_switch_text">{{paginationLabel}}</span>
            {{#listHasPaginationNextButton}}
                <button type="submit" class="page_switch_control page_switch_next" name="page_value"
                        value="{{nextPageValue}}"
                        title="{{nextButtonLable}}">
                    <i class="fa fa-angle-right" aria-hidden="true"></i></button>
            {{/listHasPaginationNextButton}}
        </div>
    </form>
{{/listHasPagination}}